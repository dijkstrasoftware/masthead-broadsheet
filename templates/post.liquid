{% assign kicker = post.post_options.kicker %}
{% if kicker == "" and post.tags != empty %}{% assign kicker = post.tags | first | map: 'name' %}{% endif %}
<article class="article">
  <header class="article-head">
    {% if kicker != "" %}<p class="kicker">{{ kicker | escape }}</p>{% endif %}
    <h1 class="headline">{{ post.title | escape }}</h1>
    {% if post.excerpt != "" %}<p class="standfirst">{{ post.excerpt | escape }}</p>{% endif %}
    <p class="meta">
      {% if post.post_options.byline != "" %}<span class="byline">{{ post.post_options.byline | escape }}</span>{% endif %}
      {% if post.published_at %}<time datetime="{{ post.published_at | iso8601 }}">{{ post.published_at | strftime: "%B %-d, %Y" }}</time>{% endif %}
      {% if theme.tokens.show_reading_time %}<span class="reading-time">{{ body_html | strip_html | size | divided_by: 1100 | plus: 1 }} min read</span>{% endif %}
    </p>
  </header>

  {% if post.post_options.featured_image != "" %}
    <figure class="article-figure">
      <img src="{{ post.post_options.featured_image }}" alt="{{ post.post_options.featured_image_alt | escape }}" />
      {% if post.post_options.caption != "" %}<figcaption>{{ post.post_options.caption | escape }}</figcaption>{% endif %}
    </figure>
  {% endif %}

  <div class="page-body article-body">{{ body_html }}</div>

  <footer class="article-foot">
    {% if theme.tokens.show_tags and post.tags != empty %}
      <p class="tag-filter">{% for tag in post.tags %}<a class="tag" href="/?tag={{ tag.slug }}">{{ tag.name | escape }}</a>{% endfor %}</p>
    {% endif %}
    <p><a class="back" href="/">&larr; {{ site.name | escape }}</a></p>
  </footer>
</article>
